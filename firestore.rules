// Otach — Firestore security rules.
//
// Data model: one `items` collection holding member-created catalogue entries.
// Every document carries `userId` = the Firebase Auth uid of its creator, and
// these rules make that ownership server-enforced:
//   * read   — only the owner (the client query carries where("userId","==",uid))
//   * create — signed in, and the new document's userId must be the caller's uid
//   * update — only the owner, and ownership cannot be handed to someone else
//   * delete — only the owner
// The storefront catalogue itself is static data in the app, so no public read
// of this collection is granted.
//
// These rules are the source of truth but they are NOT deployed by any tool in
// this repository (there is no firebase.json / .firebaserc). They must be
// published in Firebase Console → Firestore Database → Rules → Publish.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidItem() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'title',
          'shortDescription',
          'description',
          'price',
          'category',
          'imageUrl',
          'userId',
          'createdAt'
        ])
        && data.title is string
        && data.title.size() >= 3
        && data.title.size() <= 200
        && data.shortDescription is string
        && data.shortDescription.size() >= 5
        && data.shortDescription.size() <= 500
        && data.description is string
        && data.description.size() >= 20
        && data.description.size() <= 5000
        && data.price is number
        && data.price > 0
        && data.category is string
        && data.category in ['analog', 'smartwatch', 'sport']
        && data.imageUrl is string
        && data.imageUrl.size() <= 2000
        && data.userId is string
        && data.createdAt is timestamp;
    }

    match /items/{itemId} {
      allow read: if isOwner(resource.data.userId);

      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.userId
        && isValidItem();

      allow update: if isOwner(resource.data.userId)
        && request.auth.uid == request.resource.data.userId
        && isValidItem();

      allow delete: if isOwner(resource.data.userId);
    }
  }
}
